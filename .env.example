# core/config.py Settings tarafından okunan tüm ayar anahtarları.
# Gerçek değerleri girip bu dosyayı ".env" olarak kopyalayın (.env gitignore'dadır).

# Varsayılan: proje kökündeki planner.db (mutlak yol). Değiştirmek istemiyorsanız bu satırı
# tamamen silin/yorum satırı yapın — boş değer pydantic-settings tarafından "boş string" olarak
# okunup kod içindeki varsayılanı ezer (SQLAlchemy'de geçersiz bir URL'e döner).
# DATABASE_URL=

# SQLAlchemy SQL loglarını konsola bassın mı (dev/debug için).
SQLALCHEMY_ECHO=false

# Google Cloud Console'dan indirilen OAuth client secret dosyasının yolu.
GOOGLE_CREDENTIALS_FILE=credentials.json

# İlk girişten sonra otomatik oluşturulan/yenilenen token dosyasının yolu.
GOOGLE_TOKEN_FILE=token.json

# Google Calendar API scope'ları (JSON liste).
GOOGLE_CALENDAR_SCOPES=["https://www.googleapis.com/auth/calendar.events"]

# ai_advisor.py: Gemini (Google) API anahtarı. Boş bırakılırsa gerekçe/analiz/yorum
# metinleri kural tabanlı (AI'sız) üretilmeye devam eder — uygulama kırılmaz.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Kimlik doğrulama artık veritabanındaki `users` tablosu üzerinden — bkz.
# migrations/versions/f4041c5d3e59_coklu_kullanici_sistemi.py (varsayılan admin
# hesabı: kullanıcı adı "admin", geçici parola "admin123", admin panelinden
# değiştirilebilir).
